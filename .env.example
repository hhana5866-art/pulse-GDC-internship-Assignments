# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# .env is git-ignored. Keep it that way — never commit real credentials,
# not even once, not even if you delete them in a later commit.
#
# These names are a starting point. Add, remove or rename them to match
# whatever your application actually needs.

# --- Database -----------------------------------------------------------
# Matches docker-compose.yml. Change if you use your own PostgreSQL.
DB_URL=jdbc:postgresql://localhost:5432/registration
DB_USERNAME=registration
DB_PASSWORD=registration

# --- Redis --------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Mail ---------------------------------------------------------------
# Defaults below point at the Mailpit container (no auth needed).
# To send through a real provider, change these and leave the real
# values out of git.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
